{
  "name": "movie-search-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:production": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "export": "next build && next export",
    "deploy:vercel": "vercel --prod",
    "deploy:netlify": "netlify deploy --prod --dir=out",
    "deploy:gh-pages": "npm run build && npx gh-pages -d out",
    "start:production": "NODE_ENV=production next start",
    "analyze": "ANALYZE=true next build",
    "optimize": "node scripts/optimize-production.js",
    "check-config": "node scripts/check-config.js",
    "setup": "node scripts/setup-complete.js",
    "socket": "node server.js"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.7",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/lab": "^9.0.0-beta.9",
    "@mui/material": "^9.4.0",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.20.0",
    "dotenv": "^18.0.4",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
